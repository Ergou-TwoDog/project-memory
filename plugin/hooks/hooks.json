{
  "hooks": {
    "SessionStart": [{
      "hooks": [{ "type": "command", "command": "uvx --from git+https://github.com/Ergou-TwoDog/project-memory@v0.1.1 project-memory-hook", "timeout": 180 }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{ "type": "command", "command": "uvx --from git+https://github.com/Ergou-TwoDog/project-memory@v0.1.1 project-memory-hook", "timeout": 180 }]
    }],
    "PostToolUse": [{
      "matcher": "Bash",
      "hooks": [{ "type": "command", "command": "uvx --from git+https://github.com/Ergou-TwoDog/project-memory@v0.1.1 project-memory-hook", "timeout": 180 }]
    }]
  }
}
